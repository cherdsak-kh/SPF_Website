<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= pageTitle %>
    </title>

    <!-- - Icon site - -->
    <link rel="shortcut icon" href="../images/SPF_SIGN_128.png" type="image/x-icon"/>

    <!-- - Font - -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=K2D:wght@200&display=swap" rel="stylesheet">

    <!-- - Bootstrap 5.3 - -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- - TinyMCE - -->
    <script src="https://cdn.tiny.cloud/1/tqv6m5l7z2dinjx17stg6fuclckkysbyoix9n38lz1xe9gii/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>

    <!-- - Bootstrap icon - -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- - Icon pack - -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">

    <!-- - CSS Structure - -->
    <link rel="stylesheet" href="../css/structure.css">
    <link rel="stylesheet" href="../css/footer.css">

    <!-- - CSS Pages - -->
    <link rel="stylesheet" href="../css/index.css">
    <link rel="stylesheet" href="../css/event.css">
    <link rel="stylesheet" href="../css/articles.css">

    <!-- - Socket.io - -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
    </script>

    <!-- - Set style if page not index - -->
    <% if (pageName !== 'home') { %>
        <style>
            body {
                background-color: #0000009d;
                background-image:url('../images/indexBackground.jpg');
                background-repeat: no-repeat;
                background-attachment: fixed;
                background-size: cover;
                background-blend-mode: multiply;
                background-position: 0px 0px;
            }

            #header {
                backdrop-filter: blur(20px);
            }

            header {
                /* position: fixed; */
                /* top: 0; */
                /* left: 0; */
                width: 100%;
                background-color: white;
                color: black;
                transition: transform 1s ease, opacity 1s ease; /* เพิ่มการเปลี่ยนแปลงการเลื่อนและความโปร่งใส */
                z-index: 100;
                transform: translateY(-100%); /* ซ่อน header ด้วยการเลื่อนขึ้น */
                opacity: 0; /* ซ่อนด้วยความโปร่งใส */
                box-shadow: 0px 0px 100px 100px black;


                img {
                    filter: drop-shadow(0px 0px 5px yellow)
                }
            }

            header.visible {
                transform: translateY(0); /* เลื่อน header ลงมาแสดง */
                opacity: 1; /* ทำให้แสดงด้วยการปรับความโปร่งใส */
            }
        </style>
    <% } else { %>
        <style>
            body {
                background-color: #0000009d;
                background-image:url('../images/indexBackground.jpg');
                background-repeat: no-repeat;
                background-attachment: fixed;
                background-size: cover;
                background-blend-mode: multiply;
                background-position: 0px 0px;
            }
        </style>

        <link rel="stylesheet" href="../css/header.css">
    <% } %>

</head>
<body>

    <header id="header" class="p-3 bg-transparent bg-gradient text-white">
        <div class="container border-bottom border-warning pb-2">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
                <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 text-white text-decoration-none me-3">
                    <img src="../images/SPF_logo_sign.png" alt="SPF_logo_sign" width="50">
                </a>

                <ul class="nav nav-masthead col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                    <% for (let i in menu) { %>
                        <li><a href="<%= menu[i].href %>" class="nav-link px-2 <%= (pageName === menu[i].enName) ? 'text-warning' : 'text-white' %>"><%= menu[i].thName %></a></li>
                    <% } %>
                </ul>

                <div class="text-end">
                    <button type="button" class="btn btn-outline-light me-2">เข้าสู่ระบบ</button>
                    <button type="button" class="btn btn-warning">สมัครสมาชิก</button>
                </div>
            </div>
        </div>
    </header>

    <script src="../js/header.js"></script>
    
    
    