<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- - Preview Link Metadata / SEO - -->
    <meta property="og:title" content="<%= (pageName !== 'home') ? pageTitle : 'SPF : Milsim Community' %>" />
    <meta property="og:description" content="SPF Community - Arma 3 MilSim ที่รวมตัวผู้เล่นสาย Tactical FPS และ Roleplay">
    <meta property="og:image" content="<%= req.protocol + '://' + req.get('host') + '/images/spf_logo.png' %>" />
    <meta property="og:url" content="<%= req.protocol + '://' + req.get('host') + req.originalUrl %>" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SPF : Arma Milsim Community" />
    <meta name="description" content="SPF : Arma 3 Community ที่ชอบการเล่นเกมในรูปแบบ Military Simulation (MilSim) ร่วมมือกันแบบ Tactical FPS">
    <meta name="keywords" content="SPF, Arma, Milsim, Community, Arma 3, Military Simulation, MilSim, การเล่นเกม, สมจริง, ทหาร, สนุก, เล่นเกม">
    <meta name="author" content="SPF : Arma Milsim Community">
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow">
    <meta name="google" content="nositelinkssearchbox">
    <meta name="google" content="notranslate">

    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "SPF : Arma Milsim Community",
            "description": "Arma 3 Community ที่ชอบการเล่นเกมในรูปแบบ Military Simulation (MilSim)",
            "url": "<%= req.protocol + '://' + req.get('host') %>"
        }
    </script>
        

    <!-- - Title - -->
    <title>
        <%= (pageName !== 'home') ? pageTitle : 'SPF : Milsim Community' %>
    </title>

    <!-- - Icon site - -->
    <link rel="shortcut icon" href="../images/SPF_SIGN_128.png" type="image/x-icon"/>

    <!-- - Font - -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=K2D:wght@200&display=swap" rel="stylesheet">

    <!-- - Bootstrap 5.3 - -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- - TinyMCE - -->
    <!-- <script src="https://cdn.tiny.cloud/1/tqv6m5l7z2dinjx17stg6fuclckkysbyoix9n38lz1xe9gii/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script> -->

    <!-- - Bootstrap icon - -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- - Icon pack - -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">

    <!-- - CSS Structure - -->
    <link rel="stylesheet" href="../css/header.css">
    <link rel="stylesheet" href="../css/footer.css">

    <!-- - CSS Pages - -->
    <link rel="stylesheet" href="../css/index.css">
    <link rel="stylesheet" href="../css/rule.css">
    <link rel="stylesheet" href="../css/event.css">
    <link rel="stylesheet" href="../css/articles.css">

    <!-- - Socket.io - -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
    </script>

    <style>
        .big-box {
            height: 0;
            position: relative;
            background-color: #f0f0f0;
            margin-bottom: 95px;
        }

        .box {
            width: 100%;
        }
    </style>

    <% if (pageName === 'home')  { %>
    <style>
        .big-box {
            height: 100vh;
            margin-bottom: 0px;
        }

        .nav-box {
            opacity: 0;
            transform: translateY(-100%);
            transition: transform 1s ease, opacity 1s ease;
        }

        .nav-box.visible {
            transform: translateY(0);
            opacity: 1;
        }
    </style>
    <% } %>

</head>
<body>

    <div id="header" class="big-box position-relative" style="z-index: 1000;">

        <% if (pageName === 'home')  { %>
        <div class="box position-absolute top-0 start-0 vh-100 bg-dark text-white d-flex justify-content-center align-items-center overflow-hidden" style="z-index: 1;">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_01.webp" alt="Slide Show Image">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_02.webp" alt="Slide Show Image">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_03.webp" alt="Slide Show Image">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_04.webp" alt="Slide Show Image">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_05.webp" alt="Slide Show Image">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_06.webp" alt="Slide Show Image">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_07.webp" alt="Slide Show Image">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_08.webp" alt="Slide Show Image">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_09.webp" alt="Slide Show Image">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_10.webp" alt="Slide Show Image">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_11.webp" alt="Slide Show Image">
            <img class="fade-img w-100 position-absolute img-fluid fade-img-close" src="https://tmr.cthcloud.com/IMAGES/image_slide/img_12.webp" alt="Slide Show Image">
        </div>

        <div class="box position-absolute bottom-0 start-0 bg-black text-white d-flex justify-content-center align-items-center align-content-center" style="z-index: 2; box-shadow: 0px 80px 180px 230px black;"></div>

        <div class="box position-absolute top-0 start-0 vh-100 bg-transparent text-white d-flex justify-content-center align-items-center align-content-center flex-wrap" style="z-index: 3;">
            <div class="col-lg-12 w-100 text-center">
                <img class="spf-logo logo-title-effect mb-4" src="../images/spf_logo.png" alt="spf_logo" width="15%">
            </div>

            <div class="col-lg-12 w-100 text-center">
                <div class="w-75 bg-gradient rounded-top-5 mx-auto p-3">
                    <h1 class="text-shadow fw-bolder fs-1">SPF : MilSim Community</h1>
                    <h3 class="text-shadow fs-5">Arma 3 Community ที่ชอบการเล่นเกมในรูปแบบ Military Simulation (MilSim) ซึ่งผสมผสานความสมจริงทางการทหารเข้ากับความสนุกในการเล่นเกม</h3>
                </div>
            </div>

            <div class="col-lg-12 w-100 text-center">
                <hr class="border border-2 border-warning rounded opacity-50 my-4 w-75 mx-auto">
                <div class="scroll-to-view mx-auto" style="width: 20%;">
                    <button class="btn btn-lg btn-outline-light w-100" onclick="scrollToView()"><i class="bi bi-chevron-double-down"></i></button>
                </div>
            </div>

        </div>

        <style>
            @media (max-width: 992px) { /* less than 992px */
                .spf-logo {
                    width: 25%;
                }

                .scroll-to-view {
                    width: 15%;
                }
            }
        </style>

        <% } %>

        <div id="nav_box" class="box nav-box position-sticky top-0 start-0 text-white d-flex justify-content-center align-items-center" style="z-index: 4; backdrop-filter: blur(20px); box-shadow: 0px 20px 100px 50px black;">
            <div class="col-lg-12 container-fluid">
                <nav class="navbar navbar-expand-lg pb-0 w-75 mx-auto text-center">
                    <div class="container-fluid">
                        
                        <a class="navbar-brand text-center" href="/">
                            <img src="../images/SPF_logo_sign.png" class="img-fluid" alt="SPF_logo_sign" width="50" style="filter: drop-shadow(0px 0px 5px gold);">
                        </a>
        
                       <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll" aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
        
                        <div class="collapse navbar-collapse" id="navbarScroll">
                            <ul class="navbar-nav me-auto my-2 my-lg-0 navbar-nav-scroll" style="--bs-scroll-height: 200px;">
        
                                <% for (let i in menu) { %>
                                    <li class="nav-item">
                                        <a href="<%= menu[i].href %>" class="nav-link px-3 <%= (pageName === menu[i].enName) ? 'text-warning' : '' %>" aria-current="page"><%= menu[i].thName %></a>
                                    </li>
                                <% } %>
        
                            </ul>
                            
                            <div class="d-flex justify-content-center">
                                <a class="btn btn-warning" href="/termsandconditions">สมัครเข้าร่วม</a>
                            </div>
                        </div>
        
                    </div>
                </nav>
        
                <div class="hr-menu pb-2 w-75 mx-auto">
                    <div class="row">
                        <div class="col-lg-12 mx-auto">
                            <hr class="m-0 border border-1 border-warning rounded opacity-75">
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <style>
            @media (max-width: 992px) { /* Adjust for smaller screens */
                #nav_box {
                    background-color: black;
                }

                .hr-menu {
                    margin-top: 0.5rem; /* Add more margin-top when nav collapses */
                }
            }

            @media (min-width: 992px) { /* Adjust for smaller screens */
                #nav_box {
                    background-color: transparent;
                }
            }
        </style>

    </div>

    <script src="../js/header.js"></script>