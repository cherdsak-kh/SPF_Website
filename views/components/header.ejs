<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- - Preview Link Metadata / SEO - -->
    <meta property="og:title" content="<%= (pageName !== 'home') ? pageTitle : 'SPF : Milsim Community' %>" />
    <meta property="og:description" content="SPF Community - Arma 3 MilSim ที่รวมตัวผู้เล่นสาย Tactical FPS และ Roleplay">
    <meta property="og:image" content="<%= req.protocol + '://' + req.get('host') + '/images/spf_logo.png' %>" />
    <meta property="og:url" content="<%= req.protocol + '://' + req.get('host') + req.originalUrl %>" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SPF : Arma Milsim Community" />
    <meta name="description" content="SPF : Arma 3 Community ที่ชอบการเล่นเกมในรูปแบบ Military Simulation (MilSim) ร่วมมือกันแบบ Tactical FPS">
    <meta name="keywords" content="SPF, Arma, Milsim, Community, Arma 3, Military Simulation, MilSim, การเล่นเกม, สมจริง, ทหาร, สนุก, เล่นเกม">
    <meta name="author" content="SPF : Arma Milsim Community">
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow">
    <meta name="google" content="nositelinkssearchbox">
    <meta name="google" content="notranslate">

    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "SPF : Arma Milsim Community",
            "description": "Arma 3 Community ที่ชอบการเล่นเกมในรูปแบบ Military Simulation (MilSim)",
            "url": "<%= req.protocol + '://' + req.get('host') %>"
        }
    </script>
        

    <!-- - Title - -->
    <title>
        <%= (pageName !== 'home') ? pageTitle : 'SPF : Milsim Community' %>
    </title>

    <!-- - Icon site - -->
    <link rel="shortcut icon" href="../images/SPF_SIGN_128.png" type="image/x-icon"/>

    <!-- - Font - -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=K2D:wght@200&display=swap" rel="stylesheet">

    <!-- - Bootstrap 5.3 - -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- - TinyMCE - -->
    <!-- <script src="https://cdn.tiny.cloud/1/tqv6m5l7z2dinjx17stg6fuclckkysbyoix9n38lz1xe9gii/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script> -->

    <!-- - Bootstrap icon - -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- - Icon pack - -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet">

    <!-- - CSS Structure - -->
    <link rel="stylesheet" href="../css/structure.css">
    <link rel="stylesheet" href="../css/footer.css">

    <!-- - CSS Pages - -->
    <link rel="stylesheet" href="../css/index.css">
    <link rel="stylesheet" href="../css/rule.css">
    <link rel="stylesheet" href="../css/event.css">
    <link rel="stylesheet" href="../css/articles.css">

    <!-- - Socket.io - -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
    </script>

    <!-- - Set style if page not index - -->
    <% if (pageName !== 'home') { %>
        <style>
            body {
                background-color: #0000009d;
                background-image:url('../images/indexBackground.jpg');
                background-repeat: no-repeat;
                background-attachment: fixed;
                background-size: cover;
                background-blend-mode: multiply;
                background-position: 0px 0px;
            }

            #header {
                backdrop-filter: blur(20px);
            }

            header {
                /* position: fixed; */
                /* top: 0; */
                /* left: 0; */
                width: 100%;
                background-color: white;
                color: black;
                /*transition: transform 1s ease, opacity 1s ease; /* เพิ่มการเปลี่ยนแปลงการเลื่อนและความโปร่งใส */
                z-index: 100;
                /*transform: translateY(-100%); /* ซ่อน header ด้วยการเลื่อนขึ้น */
                opacity: 0; /* ซ่อนด้วยความโปร่งใส */
                box-shadow: 0px 0px 100px 100px black;


                img {
                    filter: drop-shadow(0px 0px 5px yellow)
                }
            }

            header.visible {
                transform: translateY(0); /* เลื่อน header ลงมาแสดง */
                opacity: 1; /* ทำให้แสดงด้วยการปรับความโปร่งใส */
            }
        </style>
    <% } else { %>
        <style>
            body {
                background-color: #0000009d;
                background-image:url('../images/indexBackground.jpg');
                background-repeat: no-repeat;
                background-attachment: fixed;
                background-size: cover;
                background-blend-mode: multiply;
                background-position: 0px 0px;
            }

            .header-box {
                /* background-color: green; */
                position: relative;
                min-height: 110vh;
                /* bottom: -60px; */
                top: 0;
            }

            #header {
                position: sticky;
            }

            .slideshow-inner-shadow {
                position: absolute;
                bottom: 70px;
                left: 0;
                width: 100%;
                height: 1%;
                z-index: 15;
                /* box-shadow: inset 0px -70px 90px 40px black; */
                /* background-color: black; */
                box-shadow: 0px 0px 80px 100px black;
            }
        </style>

        <link rel="stylesheet" href="../css/header.css">
    <% } %>

</head>
<body>

    <div class="header-box">
        <header id="header" class="bg-transparent">
            <nav class="container-lg navbar navbar-expand-lg pb-0">
                <div class="container-fluid">
                    
                    <a class="navbar-brand text-center" href="/">
                        <img src="../images/SPF_logo_sign.png" class="img-fluid" alt="SPF_logo_sign" width="50">
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll" aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarScroll">
                        <ul class="navbar-nav me-auto my-2 my-lg-0 navbar-nav-scroll" style="--bs-scroll-height: 100px;">

                            <% for (let i in menu) { %>
                                <li class="nav-item">
                                    <a href="<%= menu[i].href %>" class="nav-link px-3 <%= (pageName === menu[i].enName) ? 'text-warning' : '' %>" aria-current="page"><%= menu[i].thName %></a>
                                </li>
                            <% } %>

                        </ul>
                        
                        <div class="d-flex">
                            <a class="btn btn-warning" href="/termsandconditions">สมัครเข้าร่วม</a>
                        </div>
                    </div>

                </div>
            </nav>

            <div class="hr-menu container-lg pb-2">
                <div class="row">
                    <div class="col-lg-12 mx-auto">
                        <hr class="m-0 border border-1 border-warning rounded opacity-75">
                    </div>
                </div>
            </div>

            <style>
                @media (max-width: 992px) { /* Adjust for smaller screens */
                    .hr-menu {
                        margin-top: 0.5rem; /* Add more margin-top when nav collapses */
                    }
                }
            </style>
        </header>

        <div class="slideshow-inner-shadow"></div>

    </div>

    <script src="../js/header.js"></script>