<%- include('../components/header.ejs') %>

    <div class="container position-relative z-2 text-center px-2">
        <div class="row">
            <div class="col-lg-12 my-5">
                <h3 class="text-shadow">ยินดีต้อนรับสู่</h3>
                <h2 class="text-shadow fw-bold">Arma MilSim Community</h2>
            </div>
            <div class="col-lg-12 mb-3">
                <p class="text-justify fs-5 text-shadow" style="text-indent: 10%;">
                    เราคือกลุ่มผู้เล่นที่ชื่นชอบการเล่นเกมในรูปแบบ Military Simulation (MilSim) ซึ่งผสมผสานความสมจริงทางการทหารเข้ากับความสนุกในการเล่นเกม กลุ่มของเรามุ่งมั่นสร้างบรรยากาศการเล่นที่มีคุณภาพ ผ่านการทำงานเป็นทีม การสื่อสารที่มีประสิทธิภาพ และการวางแผนกลยุทธ์ในทุกภารกิจ เพื่อจำลองประสบการณ์ของการปฏิบัติภารกิจเสมือนจริงให้มากที่สุด 
                <a href="/about" class="btn btn-outline-secondary ms-2" style="--bs-btn-padding-y: .2rem; --bs-btn-padding-x: .5rem; --bs-btn-font-size: .70rem; text-indent: 0%;">อ่านต่อ</a>
                </p>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-6 p-0 px-3">
                <div id="home-img-slide-2" class="carousel slide rounded overflow-hidden p-1 card" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#home-img-slide-2" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#home-img-slide-2" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#home-img-slide-2" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    </div>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="../images/index/index-1.jpg" class="d-block w-100 rounded" alt="image-slide" onclick="imgPreview(this.src)">
                        </div>
                        <div class="carousel-item">
                            <img src="../images/index/index-2.jpg" class="d-block w-100 rounded" alt="image-slide" onclick="imgPreview(this.src)">
                        </div>
                        <div class="carousel-item">
                            <img src="../images/index/index-3.jpg" class="d-block w-100 rounded" alt="image-slide" onclick="imgPreview(this.src)">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#home-img-slide-2"
                        data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#home-img-slide-2"
                        data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-6 p-0 mb-5 px-4">
                <div class="row">
                    <div class="card text col-lg p-1 m-1">
                        <img src="../images/index/index-1.jpg" class="card-img img-fluid" alt="index-1" onclick="imgPreview(this.src)" style="cursor: pointer;">
                    </div>
                    <div class="card text col-lg p-1 m-1">
                        <img src="../images/index/index-2.jpg" class="card-img img-fluid" alt="index-2" onclick="imgPreview(this.src)" style="cursor: pointer;">
                    </div>
                    <div class="card text col-lg p-1 m-1">
                        <img src="../images/index/index-3.jpg" class="card-img img-fluid" alt="index-3" onclick="imgPreview(this.src)" style="cursor: pointer;">
                    </div>
                </div>
            </div>
        </div>
        <div class="row mb-5">
            <div class="col-lg-5 d-flex align-items-center">
                <hr class="border border-warning border-1 opacity-50 rounded w-100">
            </div>
            <div class="col-lg-2 text-center">
                <a class="btn btn-lg btn-outline-warning" href="/serverrules">สมัครเข้าร่วม</a>
            </div>
            <div class="col-lg-5 d-flex align-items-center">
                <hr class="border border-warning border-1 opacity-50 rounded w-100">
            </div>
        </div>
    </div>

    <div class="container position-relative z-2 px-2 my-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="container-fluid pt-5">
                    <h4 class="text-shadow fw-bold"><i class="bi bi-megaphone me-2"></i> ประกาศจากทีมงาน</h4>
                </div>
            </div>
        </div>
        <hr class="border border-1 border-light rounded opacity-50">
        <div class="row">
            
            <% for (let i = 0; i < 3; i++) { %>
                <div class="col-lg-4 p-2">
                    <div class="card mb-2 p-2 ">
                        <img src="../images/SPF_Example.webp" class="card-img-top" alt="image">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">News Title</h5>
                            <p class="card-text"><small>Last updated 3 mins ago</small></p>
                        </div>
                    </div>
                </div>
            <% } %>

        </div>
    </div>

