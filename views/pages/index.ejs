<%- include('../components/header.ejs') %>

    <div class="slideshow-container">
        
        <img class="fade-image img-fluid" src="../images/img001.jpg" alt="Image 1">
        <img class="fade-image img-fluid" src="../images/img002.jpg" alt="Image 2">
        <img class="fade-image img-fluid" src="../images/img003.jpg" alt="Image 3">
        <img class="fade-image img-fluid" src="../images/img004.jpg" alt="Image 4">
        <img class="fade-image img-fluid" src="../images/img005.jpg" alt="Image 5">

        <div class="slideshow-text container position-absolute top-0 start-50 translate-middle-x mt-5 d-flex flex-column align-items-center justify-content-center">
            <img class="mt-5 logo-title-effection img-fluid" src="../images/spf_logo.png" alt="SPF LOGO TITLE" width="200">
            <div class="d-flex flex-column text-white align-items-center justify-content-center mt-4 rounded-pill p-4 ps-5 pe-5 img-fluid" style="backdrop-filter: blur(3px);">
                <h1 class="fw-bolder text-center" style="font-size: 60px; text-shadow: 2px 2px 2px black;">SPF : Arma MilSim Community</h1>
                <p class="text-center" style="font-size: 16px; text-shadow: 2px 2px 2px black;">Arma 3 Community ที่ชอบการเล่นเกมในรูปแบบ Military Simulation (MilSim) ซึ่งผสมผสานความสมจริงทางการทหารเข้ากับความสนุกในการเล่นเกม</p>
                <div class="d-grid col-2 mx-auto mt-3">
                    <button class="btn btn-outline-secondary" onclick="scrollToView()"><i class="bi bi-chevron-double-down"></i></button>
                </div>
            </div>
        </div>
    </div>

    <div class="slideshow-inner-shadow"></div>

    <div id="what-is-spf" class="container position-relative text-white p-5 rounded-3" style="z-index: 5; margin: 70px auto;">
        <h3 class="text-center fw-bold">ยินดีต้อนรับสู่</h3>
        <h2 class="text-center fw-bold">Arma MilSim Community</h2>
        <div class="container px-5 pt-4">
            <p class="lh-lg fs-5" style="text-align: justify;">
                &emsp;&emsp;&emsp;&emsp;&emsp; เราคือกลุ่มผู้เล่นที่ชอบการเล่นเกมในรูปแบบ Military Simulation (MilSim) ซึ่งผสมผสานความสมจริงทางการทหารเข้ากับความสนุกในการเล่นเกม กลุ่มของเรามุ่งมั่นสร้างบรรยากาศการเล่นที่มีคุณภาพ ผ่านการทำงานเป็นทีม การสื่อสารที่มีประสิทธิภาพ และการวางแผนกลยุทธ์ในทุกภารกิจ 
                <span><a href="/about" class="btn btn-outline-secondary ms-2" style="--bs-btn-padding-y: .2rem; --bs-btn-padding-x: .5rem; --bs-btn-font-size: .70rem;">อ่านต่อ</a></span>
            </p>
