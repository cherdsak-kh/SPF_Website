<%- include('../components/header.ejs') %>

    <div class="container position-relative z-2 px-2 bg-gradient rounded">
        <div class="row px-lg-5 pt-5">
            <div class="col-lg-12 text-center">
                <h2 class="text-shadow fw-bold">ข่าวสาร/ประชาสัมพันธ์</h2>
                <p class="text-shadow">ติดตามข่าวสารและกิจกรรมล่าสุด รวมถึงประกาศสำคัญต่าง ๆ ที่เกี่ยวข้องกับเซิร์ฟเวอร์ของเราได้ที่นี่</p>
            </div>
        </div>

        <hr class="border border-2 border-light rounded opacity-50 mx-lg-5">
        
        <div class="row px-5">
            <div class="col-lg-12 p-2">
                <div class="card ">
                    <div class="row p-2">
                        <div class="col-lg-8">
                            <img src="../images/SPF_Example.webp" class="img-fluid rounded" alt="image">
                        </div>
                        <div class="col-lg-4 d-flex flex-column justify-content-between">
                            <div class="card-body">
                                <h3 class="card-title fw-bold">News Title</h3>
                                <p class="card-text">Lorem ipsum dolor sit amet consectetur adipisicing elit. Expedita corrupti, aspernatur perferendis incidunt hic laborum id debitis dolorem doloribus. Natus architecto nisi id, quam ea doloribus modi officia adipisci quia temporibus pariatur ratione accusantium velit nemo perferendis animi ipsam eos maiores fugiat. Consectetur quibusdam laudantium voluptas! Deleniti iusto expedita at?</p>
                            </div>
                            <div class="card-footer ">
                                2 days ago
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <% for (let i=0; i<6; i++) { %>
                <div class="col-lg-4 p-2">
                    <div class="card mb-2 p-2 ">
                        <img src="../images/SPF_Example.webp" class="card-img-top" alt="image">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">News Title</h5>
                            <p class="card-text"><small>Last updated 3 mins ago</small></p>
                        </div>
                    </div>
                </div>
            <% } %>

        </div>

        <hr class="border border-2 border-light rounded opacity-50 mx-lg-5">

    </div>

<%- include('../components/footer.ejs') %>