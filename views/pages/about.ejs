                    <div class="card text col-lg p-1 m-1">
                        <img src="../images/about/about-4.jpg" class="card-img img-fluid" alt="about-4" onclick="imgPreview(this.src)" style="cursor: pointer;">
                    </div>
                    <div class="card text col-lg p-1 m-1">
                        <img src="../images/about/about-5.jpg" class="card-img img-fluid" alt="about-5" onclick="imgPreview(this.src)" style="cursor: pointer;">
                    </div>
