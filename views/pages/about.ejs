<%- include('../components/header.ejs') %>

    <div class="container position-relative z-2 text-center px-2 bg-gradient rounded">
        <div class="row">
            <div class="col-lg-12 my-5 text-center">
                <img src="../images/spf_logo.png" class="img-fluid" alt="spf_logo" width="200">
            </div>
        </div>
        <div class="row px-lg-5">
            <div class="col-lg-12 mb-5">
                <h2 class="text-shadow fw-bold">รู้จักกับเรา</h2>
            </div>
            <div class="col-lg-12 mb-3 px-lg-5">
                <p class="fs-5 text-shadow text-justify" style="text-indent: 10%;">
                    เราคือกลุ่มผู้เล่นที่ชอบการเล่นเกมในรูปแบบ Military Simulation (MilSim) ซึ่งผสมผสานความสมจริงทางการทหารเข้ากับความสนุกในการเล่นเกม กลุ่มของเรามุ่งมั่นสร้างบรรยากาศการเล่นที่มีคุณภาพ ผ่านการทำงานเป็นทีม การสื่อสารที่มีประสิทธิภาพ และการวางแผนกลยุทธ์ในทุกภารกิจ
                </p>
                <p class="fs-5 text-shadow text-justify" style="text-indent: 10%;">
                    เราให้ความสำคัญกับความสมดุลระหว่าง ความจริงจัง และความสนุกสนาน โดยเน้นการร่วมมือและความเข้าใจในหมู่สมาชิก เพื่อสร้างประสบการณ์การเล่นที่สนุกและน่าจดจำ ไม่ว่าคุณจะเป็นผู้เล่นใหม่หรือผู้เล่นมากประสบการณ์ SPF พร้อมเปิดรับทุกคนที่ต้องการเข้ามาเป็นส่วนหนึ่งของกลุ่มที่ให้ความสำคัญกับทั้งการพัฒนาทักษะและการสร้างมิตรภาพผ่านการเล่นเกม
                </p>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-6 p-0 px-3">
