<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= curTitle %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <!-- - Font - -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=K2D:wght@200&display=swap" rel="stylesheet">

    <style>
        * {
            font-family: 'K2D', sans-serif;
            box-sizing: border-box;
        }
    </style>

</head>
<body>

    <div class="container position-relative" style="height: 100vh;">
        <div class="container position-absolute top-50 start-50 translate-middle text-center">
            <h1 class="fw-bold">404</h1>
            <h1 class="fw-bold">PAGE NOT FOUND</h1>
            <hr>
    
            <div class="container text-center mt-3">
                <p>This will return to normal page in <span id="countdown" class="mx-2">5</span> seconds</p>
            </div>
        </div>
    </div>

    <script src="../js/404Function.js"></script>
    
</body>
</html>